# Copy this file to .env.local and add your real keys.
# NEVER commit .env.local - it contains secrets.
#
# Local dev: copy to .env.local
# Production: set these in your hosting platform (Vercel, Railway, etc.)
#
# Get Gemini key: https://aistudio.google.com/apikey
# Get Eleven Labs key (optional, for voice): https://elevenlabs.io

GEMINI_API_KEY=your_gemini_key_here
ELEVEN_LABS_API_KEY=your_elevenlabs_key_here

